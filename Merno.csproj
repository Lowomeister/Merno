<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Merno</AssemblyName>
    <RootNamespace>Merno</RootNamespace>
    <StartupObject>Merno.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Merno</Product>
    <Description>Оптимизатор Windows 10/11</Description>
    <Copyright>Copyright © 2026 Merno contributors</Copyright>
    <Company>Merno contributors</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <StartupHookSupport>false</StartupHookSupport>
    <!-- версии и хеши пакетов NuGet фиксируются в packages.lock.json; в GitHub Actions — только из него -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(GITHUB_ACTIONS)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms нужен только для значка в трее: его типы пишем полностью, чтобы не путать с WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- Merno.Tests лежит внутри папки проекта, но собирается отдельно. -->
    <Compile Remove="Merno.Tests\**" />
    <Page Remove="Merno.Tests\**" />
    <ApplicationDefinition Remove="Merno.Tests\**" />
    <EmbeddedResource Remove="Merno.Tests\**" />
    <None Remove="Merno.Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- чистые помощники (разбор winget, Java/PhysX, версии) проверяются тестами -->
    <InternalsVisibleTo Include="Merno.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\apps.json" LogicalName="apps.json" />
    <EmbeddedResource Include="Assets\whatsnew.json" LogicalName="whatsnew.json" />
    <!-- исходник палитры: Core/Theme.cs перекрашивает его под выбранную тему при запуске -->
    <EmbeddedResource Include="Themes\Dark.xaml" LogicalName="theme.xaml" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo-pixel.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
</Project>
