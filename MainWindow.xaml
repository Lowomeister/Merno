<Window x:Class="Merno.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:Merno"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Merno" Width="1100" Height="700" MinWidth="860" MinHeight="540"
        ToolTipService.ShowDuration="30000" ToolTipService.InitialShowDelay="300" ToolTipService.BetweenShowDelay="100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
    <Window.Resources>
        <Visibility x:Key="NavLabelVis">Collapsed</Visibility>
        <!-- высота пункта меню: 34, если окно невысокое (MainWindow.NavFit.cs) -->
        <sys:Double x:Key="NavItemHeight">40</sys:Double>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковое меню: по умолчанию только иконки, раскрывается кнопкой -->
        <Border x:Name="SideBar" Grid.Column="0" Width="64" Background="{StaticResource Side}" ClipToBounds="True">
            <Border.Resources>
                <!-- стрелки «Назад» / «Вперёд» и «ещё разделы» в меню: значок — из Content; некуда идти — бледные -->
                <ControlTemplate x:Key="NavArrowTpl" TargetType="Button">
                    <Border x:Name="bb" CornerRadius="8" Background="Transparent">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource Sub}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bb" Property="Background" Value="{StaticResource Panel}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bb" Property="Opacity" Value="0.3"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Border.Resources>
            <!-- ширина — по меню (64 или 224), а не всегда 224 с обрезкой: при масштабе Windows 125–175 % край обрезки
                 попадал между пикселями, и у края свёрнутого меню вылезали полоски подсветки и надписей -->
            <DockPanel>
                <!-- шапка: логотип; кнопка сворачивания всегда под логотипом (не переезжает);
                     «Назад» — справа от логотипа в раскрытом меню, под кнопкой сворачивания в свёрнутом (ApplySide) -->
                <Grid x:Name="SideHead" DockPanel.Dock="Top" Margin="0,24,0,0" Height="84">
                    <Button x:Name="BtnLogo" Background="Transparent" BorderThickness="0" Padding="0" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                            ToolTip="На главную" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="SideLogo" Source="/Assets/logo.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{DynamicResource NavLabelVis}">
                                <TextBlock Text="Merno" FontFamily="{DynamicResource Display}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="VerText" Text="Версия" FontSize="11.5" Foreground="{StaticResource Sub}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavToggle" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,48,0,0"
                            Cursor="Hand" ToolTip="Развернуть меню" FocusVisualStyle="{x:Null}" Content="&#xE700;">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="tb" CornerRadius="8" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <TextBlock x:Name="ti" Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="14"
                                               Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="tb" Property="Background" Value="{StaticResource CardHover}"/>
                                        <Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- «Назад» и «Вперёд» — по истории разделов (ApplySide ставит их рядом с кнопкой меню); некуда идти — бледные -->
                    <Button x:Name="BtnBack" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,48,0,0"
                            IsEnabled="False" Cursor="Hand" ToolTip="Назад (Alt+←)" FocusVisualStyle="{x:Null}" Content="&#xE72B;" Template="{StaticResource NavArrowTpl}"/>
                    <Button x:Name="BtnForward" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="92,48,0,0"
                            IsEnabled="False" Cursor="Hand" ToolTip="Вперёд (Alt+→)" FocusVisualStyle="{x:Null}" Content="&#xE72A;" Template="{StaticResource NavArrowTpl}"/>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                    <Rectangle Height="1" Fill="{StaticResource Line}" Margin="16,0,16,8"/>
                    <RadioButton x:Name="NavHelp" Style="{StaticResource Nav}" Tag="&#xE897;" Content="Частые вопросы" ToolTip="Частые вопросы и подробная инструкция"/>
                    <RadioButton x:Name="NavContact" Style="{StaticResource Nav}" Tag="&#xE715;" Content="Связаться с нами" ToolTip="Написать нам в Telegram: ошибка, идея, вопрос"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Настройки" ToolTip="Настройки программы"/>
                </StackPanel>

                <!-- основные разделы — сверху, сразу под шапкой -->
                <!-- Полоса прокрутки скрыта: с Auto она то появляется, то пропадает и меняет ширину меню, раскладка зацикливается
                     и страницы застревают в узком виде. Невысокое окно (150 % на ноутбуке 1920×1080): пункты ниже,
                     а если всё равно не влезает, затухание со стрелкой поверх списка; ширину оно не меняет (MainWindow.NavFit.cs). -->
                <Grid>
                <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel VerticalAlignment="Top" Margin="0,4,0,0">
                    <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Главная" ToolTip="Оптимизация и сведения о компьютере" IsChecked="True"/>
                    <RadioButton x:Name="NavSearch" Style="{StaticResource Nav}" Tag="&#xE721;" Content="Поиск" ToolTip="Найти раздел, настройку, программу или окно Windows (Ctrl+F)"/>
                    <RadioButton x:Name="NavApps" Style="{StaticResource Nav}" Tag="&#xE7B8;" Content="Программы" ToolTip="Установка и удаление программ, приложения Windows"/>
                    <RadioButton x:Name="NavRuntime" Style="{StaticResource Nav}" Tag="&#xEA86;" Content="Компоненты" ToolTip="То, без чего не запускаются игры и программы"/>
                    <RadioButton x:Name="NavDrivers" Style="{StaticResource Nav}" Tag="&#xE772;" Content="Драйверы" ToolTip="Проверить и обновить драйверы"/>
                    <RadioButton x:Name="NavUpdates" Style="{StaticResource Nav}" Tag="&#xE895;" Content="Обновления Windows" ToolTip="Обновления Windows и драйверов, активация"/>
                    <RadioButton x:Name="NavStartup" Style="{StaticResource Nav}" Tag="&#xE7E8;" Content="Автозагрузка" ToolTip="Что запускается вместе с Windows"/>
                    <RadioButton x:Name="NavClean" Style="{StaticResource Nav}" Tag="&#xE74D;" Content="Очистка" ToolTip="Удалить мусорные файлы"/>
                    <RadioButton x:Name="NavStore" Style="{StaticResource Nav}" Content="Приложения Windows" Visibility="Collapsed"/>
                    <RadioButton x:Name="NavTools" Style="{StaticResource Nav}" Tag="&#xE90F;" Content="Инструменты" ToolTip="Починить Windows, интернет и другое"/>
                    <RadioButton x:Name="NavQuick" Style="{StaticResource Nav}" Tag="&#xE945;" Content="Быстрый доступ" ToolTip="Нужные окна Windows в один клик"/>
                    <!-- открываются из «Главной» и «Настроек», в меню не показываются -->
                    <RadioButton x:Name="NavSystem" Style="{StaticResource Nav}" Content="Мой компьютер" Visibility="Collapsed"/>
                    <RadioButton x:Name="NavRollback" Style="{StaticResource Nav}" Content="Откат изменений" Visibility="Collapsed"/>
                    <RadioButton x:Name="NavLog" Style="{StaticResource Nav}" Content="Журнал" Visibility="Collapsed"/>
                    <StackPanel x:Name="AdvancedNav" Margin="0,14,0,0">
                        <Grid Height="22" Margin="0,0,0,4">
                            <Rectangle x:Name="AdvLine" Height="1" Fill="{StaticResource Line}" Margin="16,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AdvLabel" Text="Для опытных" FontSize="12" Foreground="{StaticResource Sub}" Opacity="0.75"
                                       Margin="20,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <RadioButton x:Name="NavTweaks" Style="{StaticResource Nav}" Tag="&#xE762;" Content="Настройки Windows" ToolTip="Каждая настройка Windows по отдельности"/>
                        <RadioButton x:Name="NavMenu" Style="{StaticResource Nav}" Tag="&#xE8FD;" Content="Контекстное меню" ToolTip="Убрать лишние пункты из меню правой кнопки мыши"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
                <Grid x:Name="NavFadeTop" VerticalAlignment="Top" Height="40" Visibility="Collapsed">
                    <Border x:Name="NavFadeTopBg" IsHitTestVisible="False"/>
                    <Button x:Name="NavLess" Width="32" Height="22" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand"
                            ToolTip="Выше есть ещё разделы" FocusVisualStyle="{x:Null}" Content="&#xE70E;" Template="{StaticResource NavArrowTpl}"/>
                </Grid>
                <Grid x:Name="NavFadeBottom" VerticalAlignment="Bottom" Height="40" Visibility="Collapsed">
                    <Border x:Name="NavFadeBottomBg" IsHitTestVisible="False"/>
                    <Button x:Name="NavMore" Width="32" Height="22" HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="Hand"
                            ToolTip="Ниже есть ещё разделы" FocusVisualStyle="{x:Null}" Content="&#xE70D;" Template="{StaticResource NavArrowTpl}"/>
                </Grid>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Содержимое -->
        <!-- MainArea: сдвигается при сворачивании меню (MainWindow.xaml.cs, AnimateSide) -->
        <Grid x:Name="MainArea" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ГЛАВНАЯ: каркас «основное + боковая панель» (PageShell); страница целиком прокручивается -->
            <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
                <local:PageShell Scrolling="False">
                    <!-- шапка как у остальных страниц: заголовок слева, вкладки справа -->
                    <DockPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                        <Border DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="HomeTabFirst" Visibility="Collapsed" Style="{StaticResource Seg}" GroupName="homeTabs" Content="Настройка" ToolTip="Пошаговая настройка Windows: режим, программы, внешний вид, драйверы"/>
                                <RadioButton x:Name="HomeTabOpt" Style="{StaticResource Seg}" GroupName="homeTabs" Content="Оптимизация" ToolTip="Проверка компьютера и настройка Windows по шагам"/>
                                <RadioButton x:Name="HomeTabPc" Style="{StaticResource Seg}" GroupName="homeTabs" Content="Мой компьютер"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Главная" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- ОСНОВНОЕ -->
                    <StackPanel local:PageShell.Part="Main">
                        <!-- Баннер с луной: состояние компьютера + проверка -->
                        <Border x:Name="HomeStateCard" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,16" ClipToBounds="True">
                            <Grid MinHeight="112">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="HomeArtCol" Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- луна над горами и отражение в воде (Themes/Dark.xaml, MoonArt — в цветах темы); правый край уходит в фон карточки -->
                                <Border CornerRadius="10,0,0,10" ClipToBounds="True">
                                    <Viewbox Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Viewbox.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF000000" Offset="0.62"/>
                                                <GradientStop Color="#00000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Viewbox.OpacityMask>
                                        <!-- пиксельная сцена 130×70 (MainWindow.Banner.cs): неподвижные небо, луна и горы + кадры воды поверх; без сглаживания -->
                                        <Grid Width="260" Height="140" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True">
                                            <Image x:Name="BannerScene" Width="260" Height="140" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            <Image x:Name="BannerWater" Width="260" Height="140" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Grid>
                                    </Viewbox>
                                </Border>
                                <DockPanel Grid.Column="1" Margin="8,14,24,14" VerticalAlignment="Center">
                                    <Button x:Name="BtnCheck" DockPanel.Dock="Right" Content="Проверить компьютер" Style="{StaticResource Outline}" VerticalAlignment="Center"
                                            ToolTip="Только проверяет. Ничего не меняет."/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Добро пожаловать" Foreground="{StaticResource Sub}" FontSize="13" Margin="0,0,0,6"/>
                                        <DockPanel>
                                            <TextBlock x:Name="HomeStateText" Text="Компьютер ещё не проверен" FontSize="20" FontWeight="SemiBold" FontFamily="{DynamicResource Display}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <TextBlock x:Name="Step1Text" Style="{StaticResource SubText}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                                   Text="Merno найдёт, что тормозит компьютер и сколько накопилось мусора. Ничего не меняется."/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                        <!-- Что осталось доделать: перезагрузка, частота монитора, обновления -->
                        <StackPanel x:Name="PendingBox" Margin="0,0,0,4"/>
                        <TextBlock x:Name="HomeSys" Visibility="Collapsed"/>
                        <!-- старые отметки шагов: код ещё обновляет их, на экране не показываются -->
                        <StackPanel Visibility="Collapsed">
                            <Border x:Name="Mark1"><TextBlock x:Name="Mark1Text"/></Border>
                            <Border x:Name="Mark2"><TextBlock x:Name="Mark2Text"/></Border>
                            <Border x:Name="Mark3"><TextBlock x:Name="Mark3Text"/></Border>
                        </StackPanel>

                        <!-- Оптимизация -->
                        <!-- Настройка Windows по шагам (бывший «Первый запуск», MainWindow.FirstRun.cs) — на месте прежнего выбора режима -->
                        <Border x:Name="HomeSetup" Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,32">
                            <StackPanel>
                                <TextBlock Text="Настройка Windows" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,4,0,8" TextWrapping="Wrap"
                                           Text="По шагам: режим, программы, внешний вид, драйверы. Пока не нажмёте «Начать», ничего не меняется."/>
                                <StackPanel x:Name="FirstRunPanel"/>
                            </StackPanel>
                        </Border>
                        <!-- скрыто: оптимизация теперь — шаг 1 мастера на «Главной» (HomeSetup); код OptimizeAsync оставлен -->
                        <Border x:Name="Wizard" Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,32" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Оптимизация" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,4,0,16" Text="Как вы чаще всего пользуетесь этим компьютером?"/>
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="ProfRec" Style="{StaticResource ProfileCard}" IsChecked="True" Margin="0,0,6,0"
                                                 ToolTip="Интернет, учёба, работа, фильмы и немного игр.">
                                        <StackPanel>
                                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                                            <TextBlock Text="Обычный" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="Подходит почти всем" Foreground="{StaticResource Sub}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ProfGame" Style="{StaticResource ProfileCard}" Margin="3,0,3,0"
                                                 ToolTip="Для игр: меньше фоновых задач, точнее мышь.">
                                        <StackPanel>
                                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                                            <TextBlock Text="Игровой" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="Больше кадров, меньше рывков" Foreground="{StaticResource Sub}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ProfMin" Style="{StaticResource ProfileCard}" Margin="6,0,0,0"
                                                 ToolTip="Только самое безопасное. Для рабочего компьютера.">
                                        <StackPanel>
                                            <TextBlock Text="&#xE83D;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                                            <TextBlock Text="Бережный" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="Минимум изменений" Foreground="{StaticResource Sub}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                                <WrapPanel Margin="0,16,0,0">
                                    <CheckBox x:Name="HomeClean" Style="{StaticResource Check}" IsChecked="True" Margin="0,0,32,8" Content="Удалить мусорные файлы"
                                              ToolTip="Ненужные временные файлы. Документы, фото и игры останутся. Программы закрывать не нужно."/>
                                    <CheckBox x:Name="HomeRP" Style="{StaticResource Check}" IsChecked="True" Margin="0,0,0,8" Content="Создать точку восстановления"
                                              ToolTip="Если что-то пойдёт не так, вы сможете вернуть Windows к этому моменту."/>
                                </WrapPanel>
                                <Expander x:Name="PlanExpander" Margin="0,4,0,0" Foreground="{StaticResource Sub}">
                                    <Expander.Header>
                                        <TextBlock x:Name="PlanHeader" Text="Что будет изменено" Foreground="{StaticResource Accent}"/>
                                    </Expander.Header>
                                    <StackPanel x:Name="PlanList" Margin="0,10,0,0"/>
                                </Expander>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                                    <DockPanel>
                                        <Button x:Name="BtnGo" DockPanel.Dock="Left" Content="Оптимизировать" Style="{StaticResource Big}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HomeEstimate" Style="{StaticResource SubText}" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                                                   Text="Займёт до 10 минут. Сохраните документы и закройте игры."/>
                                    </DockPanel>
                                </Border>
                                <StackPanel x:Name="GoProgress" Margin="0,20,0,0" Visibility="Collapsed">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="GoPercent" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="0%"/>
                                        <TextBlock x:Name="GoStep" Text="…" Foreground="{StaticResource Sub}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="GoBar" Minimum="0" Maximum="100"/>
                                </StackPanel>
                                <Border x:Name="GoDone" Margin="0,20,0,0" Visibility="Collapsed"
                                        BorderBrush="{StaticResource Ok}" BorderThickness="2,0,0,0" Padding="16,2,0,2">
                                    <StackPanel>
                                        <TextBlock x:Name="GoDoneTitle" Text="Готово" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource Ok}"/>
                                        <TextBlock x:Name="GoDoneText" Style="{StaticResource SubText}" Margin="0,6,0,14"/>
                                        <WrapPanel>
                                            <Button x:Name="BtnReboot" Content="Перезагрузить" Style="{StaticResource Primary}" Margin="0,0,10,8"/>
                                            <Button x:Name="BtnOpenReport" Content="Открыть отчёт" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Частые вопросы — теперь отдельный пункт меню (PageHelp) -->
                        <TextBlock x:Name="HelpLine" Visibility="Collapsed" Margin="2,20,0,0" Foreground="{StaticResource Sub}">
                            <Run Text="Первый раз здесь? "/>
                            <Hyperlink x:Name="LinkHelpRun" Foreground="{StaticResource Accent}">Короткая инструкция</Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- БОКОВАЯ ПАНЕЛЬ: советы, о компьютере, последние действия -->
                    <StackPanel local:PageShell.Part="Side">
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Советы" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <TextBlock x:Name="HomeTipsEmpty" Style="{StaticResource SubText}" TextWrapping="Wrap"
                                           Text="Чтобы узнать, что стоит исправить и где, нажмите «Проверить компьютер»."/>
                                <StackPanel x:Name="CheckResults" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="16,16,16,8" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="О компьютере" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <StackPanel x:Name="HwTags"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="16,16,16,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13">
                                        <Hyperlink x:Name="LinkHomeHistory" Foreground="{StaticResource Accent}">Все →</Hyperlink>
                                    </TextBlock>
                                    <TextBlock Text="Последние действия" FontWeight="SemiBold" FontSize="15"/>
                                </DockPanel>
                                <StackPanel x:Name="HomeRecent"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </local:PageShell>
            </ScrollViewer>
            <!-- ВСЕ НАСТРОЙКИ -->
            <local:PageShell x:Name="PageTweaks" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <DockPanel>
                        <Button x:Name="TweakMore" DockPanel.Dock="Right" Content="&#xE712;" FontFamily="{StaticResource Icons}" Style="{StaticResource Ghost}"
                                Padding="10,8" VerticalAlignment="Center" ToolTip="Сохранить или открыть набор">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="PSave" Header="Сохранить набор в файл" ToolTip="Чтобы применить те же настройки на другом компьютере."/>
                                    <MenuItem x:Name="PLoad" Header="Открыть набор из файла"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock Text="Настройки Windows" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Text="Галочка означает, что настройка включена. Измените нужное и нажмите «Применить»."/>
                </StackPanel>
                <DockPanel local:PageShell.Part="Toolbar" Margin="0,0,0,12" Height="40">
                    <Border x:Name="TweakFilter" DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="10" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TweakFilterAll" Style="{StaticResource Seg}" GroupName="tweakFilter" Content="Все" IsChecked="True"/>
                            <RadioButton x:Name="TweakFilterChanged" Style="{StaticResource Seg}" GroupName="tweakFilter" Content="Изменено"/>
                            <RadioButton x:Name="TweakFilterRisk" Style="{StaticResource Seg}" GroupName="tweakFilter" Content="Осторожно"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <TextBox x:Name="Search" Padding="36,0,12,0" VerticalContentAlignment="Center" FontSize="14" ToolTip="Поиск по названию и описанию"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Sub}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,1,0,0"/>
                        <TextBlock x:Name="SearchHint" Text="Найти настройку…" IsHitTestVisible="False" Foreground="{StaticResource Sub}" Opacity="0.7" FontSize="14" VerticalAlignment="Center" Margin="40,0,0,0"/>
                    </Grid>
                </DockPanel>
                <ScrollViewer x:Name="TweakScroll" local:PageShell.Part="Main" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <local:FlowColumns x:Name="TweakList" Margin="0,0,0,20" VerticalAlignment="Top"/>
                </ScrollViewer>
                <ScrollViewer local:PageShell.Part="Side" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Изменения" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="TweakCount" Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TweakRebootNote" FontSize="13" Foreground="{StaticResource Warn}" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Run Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="12"/><Run Text="  Нужна перезагрузка"/>
                                </TextBlock>
                                <StackPanel x:Name="TweakOptions" Margin="0,12,0,0">
                                    <!-- подпись переносится: в узкой боковой карточке строка обрезалась («перед «…») -->
                                    <CheckBox x:Name="TweakRP" Style="{StaticResource Check}" IsChecked="True" Margin="0,0,0,8" FontSize="13"><TextBlock TextWrapping="Wrap" Text="Точка восстановления перед рискованными настройками"/></CheckBox>
                                    <CheckBox x:Name="TweakReport" Style="{StaticResource Check}" IsChecked="True" FontSize="13"><TextBlock TextWrapping="Wrap" Text="Отчёт на рабочий стол"/></CheckBox>
                                </StackPanel>
                                <Button x:Name="BtnApply" Content="Применить" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Margin="0,16,0,0" Padding="14,9"/>
                                <Button x:Name="BtnResetSel" Content="Отменить изменения" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <!-- «Наборы» скрыты: наборы — только в мастере на «Главной» -->
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Наборы" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Button x:Name="PRec" Style="{StaticResource ListBtn}" Margin="0,0,0,6"/>
                                <Button x:Name="PGame" Style="{StaticResource ListBtn}" Margin="0,0,0,6"/>
                                <Button x:Name="PMin" Style="{StaticResource ListBtn}"/>
                                <TextBlock Style="{StaticResource SubText}" FontSize="12" Margin="0,8,0,0" Text="Набор только отмечает настройки. Чтобы применить их, нажмите кнопку выше."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="16,14,16,10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Разделы" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <StackPanel x:Name="TweakJump"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SubText}" Margin="4,0,4,0">
                            <Run Text="Сохранённые настройки можно вернуть в разделе"/>
                            <Hyperlink x:Name="TweakRollbackLink" Foreground="{StaticResource Accent}">«Откат изменений»</Hyperlink><Run Text="."/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </local:PageShell>

            <!-- ОЧИСТКА -->
            <local:PageShell x:Name="PageClean" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock Text="Очистка" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Text="Удаляем только мусор. Документы, фото и игры не трогаем."/>
                </StackPanel>
                <ScrollViewer local:PageShell.Part="Main" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <local:FlowColumns x:Name="CleanList" Margin="0,0,0,20" VerticalAlignment="Top"/>
                </ScrollViewer>
                <ScrollViewer local:PageShell.Part="Side" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="CleanTotalLabel" Text="Можно освободить" Style="{StaticResource SubText}"/>
                                <TextBlock x:Name="CleanTotal" FontFamily="{DynamicResource Display}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CleanSelInfo" Style="{StaticResource SubText}" Margin="0,2,0,0"/>
                                <Button x:Name="BtnClean" Content="Очистить отмеченное" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Margin="0,16,0,0" Padding="14,9"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="BtnScan" Content="Посчитать заново" Style="{StaticResource Link}"/>
                                    <Button x:Name="CleanLogLink" Content="Подробнее в журнале" Style="{StaticResource Link}" Margin="16,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="CleanDiskTitle" Text="Диск C:" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="CleanFreeDisk" Style="{StaticResource SubText}" Margin="0,4,0,10"/>
                                <Grid Height="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="CleanDiskUsed" Width="0*"/>
                                        <ColumnDefinition x:Name="CleanDiskFree" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" Background="{StaticResource Line}" CornerRadius="2"/>
                                    <Border x:Name="CleanDiskBar" Background="{StaticResource Accent}" CornerRadius="2"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SubText}" Margin="4,0,4,0"
                                   Text="Программы закрывать не нужно. Корзину и файлы видеокарты чистим, только если вы их отметите."/>
                    </StackPanel>
                </ScrollViewer>
            </local:PageShell>

            <!-- АВТОЗАГРУЗКА -->
            <local:PageShell x:Name="PageStartup" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <DockPanel>
                        <Button x:Name="StartSort" DockPanel.Dock="Right" Style="{StaticResource Ghost}" VerticalAlignment="Center"/>
                        <TextBlock Text="Автозагрузка" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Text="Что запускается вместе с Windows. Выключенная программа не удаляется и больше не запускается сама."/>
                </StackPanel>
                <ScrollViewer local:PageShell.Part="Main" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><local:FlowColumns x:Name="StartList" Margin="0,0,0,20" VerticalAlignment="Top"/></ScrollViewer>
                <ScrollViewer local:PageShell.Part="Side" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Изменения" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="StartSelCount" Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <Button x:Name="BtnStartApply" Content="Применить" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Margin="0,16,0,0" Padding="14,9"/>
                                <Button x:Name="BtnStartSelNone" Content="Отменить изменения" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Включено" Style="{StaticResource SubText}"/>
                                <TextBlock x:Name="StartCount" FontFamily="{DynamicResource Display}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="StartCountInfo" Style="{StaticResource SubText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <Button x:Name="BtnStartAdd" Content="Добавить свою программу" Style="{StaticResource Outline}" HorizontalAlignment="Stretch" Margin="0,16,0,0" Padding="14,9"/>
                                <Button x:Name="BtnStartRefresh" Content="Обновить список" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SubText}" Margin="4,0,4,0" TextWrapping="Wrap"
                                   Text="Изменения сработают при следующем включении компьютера."/>
                    </StackPanel>
                </ScrollViewer>
            </local:PageShell>

            <!-- МОЙ КОМПЬЮТЕР -->
            <!-- ПЕРВЫЙ ЗАПУСК: пошаговый мастер (MainWindow.FirstRun.cs) -->
            <ScrollViewer x:Name="PageFirstRun" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <local:PageShell Scrolling="False">
                    <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FrTabFirst" Visibility="Collapsed" Style="{StaticResource Seg}" GroupName="frTabs" Content="Настройка" ToolTip="Пошаговая настройка Windows: режим, программы, внешний вид, драйверы"/>
                                    <RadioButton x:Name="FrTabOpt" Style="{StaticResource Seg}" GroupName="frTabs" Content="Оптимизация" ToolTip="Проверка компьютера и настройка Windows по шагам"/>
                                    <RadioButton x:Name="FrTabPc" Style="{StaticResource Seg}" GroupName="frTabs" Content="Мой компьютер"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Главная" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="Настройка Windows по шагам: режим, программы, внешний вид, драйверы. Лишнее можно пропустить."/>
                    </StackPanel>
                    <StackPanel x:Name="FirstRunPanelOld" local:PageShell.Part="Main"/>
                    <StackPanel local:PageShell.Part="Side">
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Как это работает" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource SubText}"
                                           Text="На каждом шаге отметьте нужное. Пока вы не нажали «Начать», ничего не меняется. В конце Merno сделает всё сам."/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SubText}" Margin="4,0,4,0"
                                   Text="Сохранённые настройки можно вернуть в «Откате изменений». Очистку файлов и удаление приложений отменить нельзя."/>
                    </StackPanel>
                </local:PageShell>
            </ScrollViewer>

            <ScrollViewer x:Name="PageSystem" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <local:PageShell Scrolling="False">
                    <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SysTabFirst" Visibility="Collapsed" Style="{StaticResource Seg}" GroupName="sysTabs" Content="Настройка" ToolTip="Пошаговая настройка Windows: режим, программы, внешний вид, драйверы"/>
                                    <RadioButton x:Name="SysTabOpt" Style="{StaticResource Seg}" GroupName="sysTabs" Content="Оптимизация" ToolTip="Проверка компьютера и настройка Windows по шагам"/>
                                    <RadioButton x:Name="SysTabPc" Style="{StaticResource Seg}" GroupName="sysTabs" Content="Мой компьютер"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Мой компьютер" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="Что внутри компьютера и что стоит исправить."/>
                    </StackPanel>
                    <StackPanel local:PageShell.Part="Main">
                        <!-- Монитор: частота обновления экрана (MainWindow.Monitor.cs). -->
                        <Border x:Name="MonCard" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Монитор" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,4,0,10" TextWrapping="Wrap"
                                           Text="Чем выше частота, тем плавнее картинка и игры. Если экран погаснет, через 15 секунд всё вернётся само."/>
                                <StackPanel x:Name="MonList"/>
                            </StackPanel>
                        </Border>
                        <!-- две независимые колонки: карточки не растягиваются под соседнюю, нет пустот -->
                        <Grid x:Name="SysCards" Margin="0,0,-12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel x:Name="SysColL"/>
                            <StackPanel x:Name="SysColR" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel local:PageShell.Part="Side">
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Что стоит исправить" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <StackPanel x:Name="SysIssues"/>
                                <TextBlock x:Name="SysIssuesEmpty" Style="{StaticResource SubText}" Text="Проблем не найдено." Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <!-- Температура в реальном времени (MainWindow.Temps.cs) -->
                        <StackPanel x:Name="SysTemps"/>
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Сведения" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,12" Text="Скопируйте сведения одним текстом и вставьте их в сообщение в Telegram."/>
                                <Button x:Name="BtnCopyInfo" Content="Скопировать сведения" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </local:PageShell>
            </ScrollViewer>

            <!-- ИНСТРУМЕНТЫ -->
            <local:PageShell x:Name="PageTools" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <TextBlock Text="Инструменты" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Text="На случай, если что-то работает не так."/>
                </StackPanel>
                <ScrollViewer local:PageShell.Part="Main" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <!-- плитки: колонок столько, сколько помещается; вся карточка — кнопка -->
                    <UniformGrid x:Name="ToolList" Columns="3" Margin="0,0,-12,20" VerticalAlignment="Top"/>
                </ScrollViewer>
                <ScrollViewer local:PageShell.Part="Side" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Что-то сломалось после Merno?" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,12" Text="Сохранённые настройки можно вернуть. Очистку файлов и удаление приложений отменить нельзя."/>
                                <Button x:Name="BtnToolsRollback" Content="Откат изменений" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Нашли ошибку в Merno?" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,12" TextWrapping="Wrap" Text="Напишите, что пошло не так. Это поможет нам подготовить исправление."/>
                                <Button x:Name="BtnToolsContact" Content="Сообщить об ошибке" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </local:PageShell>

            <!-- БЫСТРЫЙ ДОСТУП -->
            <!-- ПОИСК ПО ВСЕЙ ПРОГРАММЕ (MainWindow.SearchPage.cs) -->
            <local:PageShell x:Name="PageSearch" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <TextBlock Text="Поиск" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Text="Введите несколько букв, чтобы найти раздел, настройку, программу или окно Windows."/>
                </StackPanel>
                <Grid local:PageShell.Part="Toolbar" Margin="0,0,0,12" Height="40">
                    <TextBox x:Name="GlobalSearch" Padding="36,0,12,0" VerticalContentAlignment="Center" FontSize="14"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Sub}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,1,0,0"/>
                    <TextBlock x:Name="GlobalSearchHint" Text="Например: частота, автозагрузка, Chrome, реестр…" IsHitTestVisible="False" Foreground="{StaticResource Sub}" Opacity="0.7" FontSize="14" VerticalAlignment="Center" Margin="40,0,0,0"/>
                </Grid>
                <ScrollViewer local:PageShell.Part="Main" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel x:Name="GlobalSearchList" Margin="0,0,0,20"/></ScrollViewer>
            </local:PageShell>

            <local:PageShell x:Name="PageQuick" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <TextBlock Text="Быстрый доступ" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Text="Открывайте в один клик окна и настройки Windows, которые обычно долго искать."/>
                </StackPanel>
                <Grid local:PageShell.Part="Toolbar" Margin="0,0,0,12" Height="40">
                    <TextBox x:Name="QuickSearch" Padding="36,0,12,0" VerticalContentAlignment="Center" FontSize="14" ToolTip="Поиск по названию и описанию в вашем списке и во всём каталоге"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Sub}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,1,0,0"/>
                    <TextBlock x:Name="QuickSearchHint" Text="Найти окно: реестр, звук, диски…" IsHitTestVisible="False" Foreground="{StaticResource Sub}" Opacity="0.7" FontSize="14" VerticalAlignment="Center" Margin="40,0,0,0"/>
                </Grid>
                <ScrollViewer local:PageShell.Part="Main" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><local:FlowColumns x:Name="QuickAdvList" Margin="0,0,0,20" VerticalAlignment="Top"/></ScrollViewer>
                <ScrollViewer local:PageShell.Part="Side" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="В списке" Style="{StaticResource SubText}"/>
                                <TextBlock x:Name="QuickCount" FontFamily="{DynamicResource Display}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="QuickCountInfo" Style="{StaticResource SubText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <Button x:Name="BtnQuickEdit" Content="Выбрать окна Windows" Style="{StaticResource Outline}" HorizontalAlignment="Stretch" Margin="0,14,0,0" Padding="14,8"/>
                            </StackPanel>
                        </Border>
                        <!-- свои программы, папки и сайты — сразу на виду, а не в окне «Изменить список» (MainWindow.Quick.cs: InitQuickAdd) -->
                        <Border x:Name="QuickAddCard" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
