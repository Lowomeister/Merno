                                <TextBlock Text="Добавить своё" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,3,0,10" Text="Программу, игру, папку или сайт можно открыть одним нажатием."/>
