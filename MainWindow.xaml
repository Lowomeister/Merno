                                    <StackPanel Orientation="Horizontal">
                                        <!-- узкий отступ: в боковой панели 256 px три кнопки иначе не помещаются -->
                                        <RadioButton x:Name="QuickAddExe" Style="{StaticResource Seg}" Padding="8,7" GroupName="quickAdd" Content="Программа" IsChecked="True"/>
                                        <RadioButton x:Name="QuickAddDir" Style="{StaticResource Seg}" Padding="8,7" GroupName="quickAdd" Content="Папка"/>
                                        <RadioButton x:Name="QuickAddWeb" Style="{StaticResource Seg}" Padding="8,7" GroupName="quickAdd" Content="Сайт"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="QuickAddTargetLabel" Text="Что открыть" Foreground="{StaticResource Sub}" FontSize="12.5" Margin="0,12,0,4"/>
                                <DockPanel>
                                    <Button x:Name="QuickAddBrowse" DockPanel.Dock="Right" Content="Обзор…" Margin="6,0,0,0" Padding="10,5"/>
                                    <TextBox x:Name="QuickAddTarget" Padding="8,5" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="QuickAddErr" Foreground="{StaticResource Bad}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <TextBlock Text="Название" Foreground="{StaticResource Sub}" FontSize="12.5" Margin="0,10,0,4"/>
                                <TextBox x:Name="QuickAddName" Padding="8,5" VerticalContentAlignment="Center" MaxLength="40"/>
                                <Button x:Name="QuickAddBtn" Content="Добавить" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Margin="0,14,0,0" Padding="14,8" IsEnabled="False"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </local:PageShell>

            <!-- ОТКАТ -->
            <local:PageShell x:Name="PageRollback" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <Button Content="← Настройки" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,0,0,8" x:Name="BackFromRollback" Visibility="Collapsed"/>
                    <TextBlock Text="Откат изменений" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Text="Что-то работает не так после оптимизации? Выберите запись и верните как было."/>
                </StackPanel>
                <ListBox x:Name="BakList" local:PageShell.Part="Main" Margin="0,0,0,20" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <ScrollViewer local:PageShell.Part="Side" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Вернуть как было" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,14"
                                           Text="Merno вернёт всё, что изменил в выбранной записи: настройки, службы и автозагрузку. После этого нужна перезагрузка."/>
                                <Button x:Name="BtnRollback" Content="Вернуть как было" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Padding="14,9"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Не помогло?" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,12"
                                           Text="Вернёт Windows к состоянию на выбранную дату, если точка была создана."/>
                                <Button x:Name="BtnSysRestore" Content="Восстановление системы" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </local:PageShell>

            <!-- ИНСТРУКЦИЯ -->
            <!-- ЧАСТЫЕ ВОПРОСЫ (пункт меню; раньше были внизу «Главной») + подробная инструкция ниже -->
            <local:PageShell x:Name="PageHelp" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <TextBlock Text="Частые вопросы" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" Text="Как начать, что есть в программе и что делать, если что-то пошло не так."/>
                </StackPanel>
                <ScrollViewer x:Name="HelpScroll" local:PageShell.Part="Main" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock x:Name="HelpStartHead" Text="Как начать" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,10"/>
                        <StackPanel x:Name="HelpStart"/>
                        <TextBlock x:Name="HelpSecHead" Text="Что есть в программе" FontSize="15" FontWeight="SemiBold" Margin="4,22,0,10"/>
                        <StackPanel x:Name="HelpSections"/>
                        <!-- сами вопросы скрыты -->
                        <TextBlock x:Name="HelpFaqHead" Visibility="Collapsed" Text="Частые вопросы" FontSize="15" FontWeight="SemiBold" Margin="4,22,0,10"/>
                        <Grid Height="40" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBox x:Name="FaqFilter" Padding="36,0,12,0" VerticalContentAlignment="Center" FontSize="14"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Sub}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,1,0,0"/>
                            <TextBlock x:Name="FaqFilterHint" Text="Найти вопрос…" IsHitTestVisible="False" Foreground="{StaticResource Sub}" Opacity="0.7" FontSize="14" VerticalAlignment="Center" Margin="40,0,0,0"/>
                        </Grid>
                        <StackPanel x:Name="FaqBox" Visibility="Collapsed"/>
                        <TextBlock x:Name="HelpHead" Text="Если что-то пошло не так" FontSize="15" FontWeight="SemiBold" Margin="4,22,0,10"/>
                        <StackPanel x:Name="HelpPanel"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer local:PageShell.Part="Side" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="16,14,16,10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Разделы" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <StackPanel x:Name="HelpJump"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SubText}" Margin="4,0,4,0" TextWrapping="Wrap" Text="Не нашли ответ?&#xA;Откройте «Связаться с нами» и напишите нам в Telegram."/>
                    </StackPanel>
                </ScrollViewer>
            </local:PageShell>

            <!-- ЖУРНАЛ -->
            <local:PageShell x:Name="PageLog" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <Button x:Name="BackFromLog" Content="← Настройки" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <TextBlock Text="Журнал" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Text="Всё, что делал Merno, по порядку."/>
                </StackPanel>
                <TextBox x:Name="LogBox" local:PageShell.Part="Main" Margin="0,0,0,20" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="12,10"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource Side}"/>
                <StackPanel local:PageShell.Part="Side">
                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Файлы журнала" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,12"
                                       Text="Что-то пошло не так? Приложите файл журнала к сообщению в Telegram."/>
                            <Button x:Name="BtnOpenLogs" Content="Открыть папку" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </local:PageShell>

            <!-- ПРОГРАММЫ -->
            <local:PageShell x:Name="PageApps" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ApAInst" Style="{StaticResource Seg}" GroupName="segA" Content="Установить"/>
                                <RadioButton x:Name="ApADel" Style="{StaticResource Seg}" GroupName="segA" Content="Удалить"/>
                                <RadioButton x:Name="ApAWin" Style="{StaticResource Seg}" GroupName="segA" Content="Приложения Windows"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Программы" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="AppsHint" Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left"
                               Text="Проверенные программы с официальных сайтов без рекламы и лишних галочек." TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <!-- поиск: значок лупы внутри поля, кнопка той же высоты -->
                <DockPanel local:PageShell.Part="Toolbar" Margin="0,0,0,12" Height="40">
                    <Button x:Name="BtnAppSearch" DockPanel.Dock="Right" Content="Найти" Margin="8,0,0,0" VerticalAlignment="Stretch" Padding="22,0"/>
                    <Grid>
                        <TextBox x:Name="AppSearch" Padding="36,0,12,0" VerticalContentAlignment="Center" FontSize="14"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Sub}" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="14,1,0,0"/>
                        <TextBlock x:Name="AppSearchHint" Text="Найти другую программу: Visual Studio Code, OBS, qBittorrent…" IsHitTestVisible="False"
                                   Foreground="{StaticResource Sub}" Opacity="0.7" FontSize="14" VerticalAlignment="Center" Margin="40,0,0,0"/>
                    </Grid>
                </DockPanel>
                <ScrollViewer local:PageShell.Part="Main" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <local:FlowColumns x:Name="AppsList" Margin="0,0,0,20"/>
                </ScrollViewer>
                <ScrollViewer local:PageShell.Part="Side" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ход установки (вариант А): видна, пока идёт очередь; обновляется, только пока открыт этот раздел — MainWindow.InstallProgress.cs -->
                        <Border x:Name="InstCard" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel x:Name="InstCardBody"/>
                        </Border>
                        <!-- выбор нескольких программ: установить или удалить разом (MainWindow.Batch.cs) -->
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel x:Name="AppsSelBar"/>
                        </Border>
                        <!-- обновления установленных программ (winget upgrade) — MainWindow.Apps.cs, BuildUpdatesCardAsync -->
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel x:Name="AppsUpdBar"/>
                        </Border>

                        <!-- категории скрыты -->
                        <Border Style="{StaticResource CardBorder}" Padding="16,14,16,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Категории" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <StackPanel x:Name="AppsCats"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </local:PageShell>

            <!-- КОМПОНЕНТЫ -->
            <local:PageShell x:Name="PageRuntime" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <TextBlock Text="Компоненты" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left"
                               Text="Без них игры сообщают об ошибке вроде «не найден …dll». После переустановки Windows их почти нет." TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <ScrollViewer local:PageShell.Part="Main" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <local:FlowColumns x:Name="RuntimeList" Margin="0,0,0,20"/>
                </ScrollViewer>
                <ScrollViewer local:PageShell.Part="Side" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Всё нужное разом" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="RuntimeAllNote" Style="{StaticResource SubText}" Margin="0,4,0,12"
                                           Text="Visual C++ всех версий, .NET 8 и DirectX. Займёт несколько минут."/>
                                <Button x:Name="BtnRuntimeAll" Content="Установить всё нужное" Style="{StaticResource Primary}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                        <!-- выбор нескольких компонентов (MainWindow.Batch.cs) -->
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel x:Name="RuntimeSelBar"/>
                        </Border>
                        <TextBlock Style="{StaticResource SubText}" Margin="4,0,4,0"
                                   Text="Игра пишет «не найден MSVCP140.dll» или «нужен .NET»? Почти всегда хватает кнопки «Установить всё нужное»."/>
                    </StackPanel>
                </ScrollViewer>
            </local:PageShell>
            <!-- ВЕРНУТЬ ПРИЛОЖЕНИЯ -->
            <local:PageShell x:Name="PageStore" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <DockPanel>                        <Border DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ApWInst" Style="{StaticResource Seg}" GroupName="segW" Content="Установить"/>
                                <RadioButton x:Name="ApWDel" Style="{StaticResource Seg}" GroupName="segW" Content="Удалить"/>
                                <RadioButton x:Name="ApWWin" Style="{StaticResource Seg}" GroupName="segW" Content="Приложения Windows"/>
                            </StackPanel>
                        </Border>                        <TextBlock Text="Программы" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Text="Встроенные приложения Windows. Если удалили нужное приложение, нажмите «Вернуть»."/>
                </StackPanel>                <Grid local:PageShell.Part="Toolbar" Margin="0,0,0,12" Height="40">
                    <TextBox x:Name="StoreFilter" Padding="36,0,12,0" VerticalContentAlignment="Center" FontSize="14"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Sub}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,1,0,0"/>
                    <TextBlock x:Name="StoreFilterHint" Text="Найти приложение: Фотографии, Калькулятор, Xbox…" IsHitTestVisible="False" Foreground="{StaticResource Sub}" Opacity="0.7" FontSize="14" VerticalAlignment="Center" Margin="40,0,0,0"/>
                </Grid>                <ScrollViewer local:PageShell.Part="Main" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><local:FlowColumns x:Name="StoreList" Margin="0,0,0,20"/></ScrollViewer>
                <StackPanel local:PageShell.Part="Side">
                    <!-- «Отмеченные»: вернуть или удалить несколько приложений разом (MainWindow.Batch.cs, AppSelGroup) -->
                    <Border Style="{StaticResource CardBorder}" Padding="16">
                        <StackPanel x:Name="StoreSelBar"/>
                    </Border>
                </StackPanel>
            </local:PageShell>

            <!-- УДАЛИТЬ ПРОГРАММЫ -->
            <local:PageShell x:Name="PageUninstall" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <DockPanel>                        <Border DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ApDInst" Style="{StaticResource Seg}" GroupName="segD" Content="Установить"/>
                                <RadioButton x:Name="ApDDel" Style="{StaticResource Seg}" GroupName="segD" Content="Удалить"/>
                                <RadioButton x:Name="ApDWin" Style="{StaticResource Seg}" GroupName="segD" Content="Приложения Windows"/>
                            </StackPanel>
                        </Border>                        <TextBlock Text="Программы" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Text="Всё, что установлено на компьютере. Для обычной программы откроется её окно удаления."/>
                </StackPanel>                <Grid local:PageShell.Part="Toolbar" Margin="0,0,0,12" Height="40">
                    <TextBox x:Name="UnFilter" Padding="36,0,12,0" VerticalContentAlignment="Center" FontSize="14"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Sub}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,1,0,0"/>
                    <TextBlock x:Name="UnFilterHint" Text="Найти программу на компьютере…" IsHitTestVisible="False" Foreground="{StaticResource Sub}" Opacity="0.7" FontSize="14" VerticalAlignment="Center" Margin="40,0,0,0"/>
                </Grid>                <ScrollViewer local:PageShell.Part="Main" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><local:FlowColumns x:Name="UnList" Margin="0,0,0,20"/></ScrollViewer>
                <ScrollViewer local:PageShell.Part="Side" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- выбор нескольких программ: удалить разом (MainWindow.Batch.cs) -->
                        <Border x:Name="UnSelCard" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel x:Name="UnSelBar"/>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Показать" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Border x:Name="UnViewBar" Background="{StaticResource Bg}" CornerRadius="10" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                    <StackPanel>
                                        <RadioButton x:Name="UnViewAll" Style="{StaticResource Seg}" GroupName="unView" Content="Все программы" IsChecked="True"/>
                                        <RadioButton x:Name="UnViewBuiltin" Style="{StaticResource Seg}" GroupName="unView" Content="Встроенные приложения" ToolTip="Cortana, Xbox, Новости, Погода и другие предустановленные приложения"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="UnSort" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                <Button x:Name="BtnUnRefresh" Content="Обновить список" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SubText}" Margin="4,0,4,0"
                                   Text="Системные программы и драйверы здесь не удаляются: без них Windows и игры могут перестать работать."/>
                    </StackPanel>
                </ScrollViewer>
            </local:PageShell>

            <!-- КОНТЕКСТНОЕ МЕНЮ -->
            <local:PageShell x:Name="PageMenu" Visibility="Collapsed">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <TextBlock Text="Контекстное меню" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Text="Уберите лишние пункты из меню правой кнопки мыши."/>
                </StackPanel>
                <DockPanel local:PageShell.Part="Toolbar" Margin="0,0,0,12" Height="40">
                    <Border x:Name="MenuFilter" DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="10" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="MenuFilterAll" Style="{StaticResource Seg}" GroupName="menuFilter" Content="Все" IsChecked="True"/>
                            <RadioButton x:Name="MenuFilterShown" Style="{StaticResource Seg}" GroupName="menuFilter" Content="Включены"/>
                            <RadioButton x:Name="MenuFilterHidden" Style="{StaticResource Seg}" GroupName="menuFilter" Content="Выключены"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <TextBox x:Name="MenuSearch" Padding="36,0,12,0" VerticalContentAlignment="Center" FontSize="14"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Sub}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,1,0,0"/>
                        <TextBlock x:Name="MenuSearchHint" Text="Найти пункт…" IsHitTestVisible="False" Foreground="{StaticResource Sub}" Opacity="0.7" FontSize="14" VerticalAlignment="Center" Margin="40,0,0,0"/>
                    </Grid>
                </DockPanel>
                <ScrollViewer local:PageShell.Part="Main" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <local:FlowColumns x:Name="MenuList" Margin="0,0,0,20" VerticalAlignment="Top"/>
                </ScrollViewer>
                <ScrollViewer local:PageShell.Part="Side" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Изменения" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="MenuSelCount" Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <Button x:Name="BtnMenuApply" Content="Применить" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Margin="0,16,0,0" Padding="14,9"/>
                                <Button x:Name="BtnMenuSelNone" Content="Отменить изменения" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="MenuJunkLabel" Text="Лишних пунктов" Style="{StaticResource SubText}"/>
                                <TextBlock x:Name="MenuJunkCount" FontFamily="{DynamicResource Display}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,2,0,0"/>
                                <Button x:Name="BtnMenuJunk" Content="Убрать лишнее" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Margin="0,14,0,0" Padding="14,9"
                                        ToolTip="Скроет «Поделиться», «Изменить в Paint», Copilot и другие бесполезные пункты."/>
                                <TextBlock x:Name="MenuNote" Style="{StaticResource SubText}" FontSize="12" Margin="0,8,0,0" Text="Пункты ваших программ не трогаем."/>
                                <TextBlock x:Name="MenuRestartNote" Style="{StaticResource SubText}" Foreground="{StaticResource Warn}" Margin="0,14,0,0" Visibility="Collapsed"
                                           Text="Чтобы изменения стали видны, перезапустите Проводник. Открытые папки закроются."/>
                                <Button x:Name="BtnMenuExplorer" Content="Перезапустить Проводник" Style="{StaticResource Outline}" HorizontalAlignment="Stretch" Margin="0,10,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="MenuClassicCard" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Вид меню" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <CheckBox x:Name="MenuClassic" Style="{StaticResource Check}" FontSize="13.5" Content="Меню как в Windows 10"/>
                                <TextBlock Style="{StaticResource SubText}" FontSize="12" Margin="0,8,0,0" Text="Меню без пункта «Показать дополнительные параметры». Проводник перезапустится."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="16,14,16,12">
                            <StackPanel>
                                <TextBlock Text="Разделы" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <StackPanel x:Name="MenuJump"/>
                                <Button x:Name="BtnMenuReset" Content="Вернуть все пункты" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </local:PageShell>

            <!-- ДРАЙВЕРЫ, ОБНОВЛЕНИЯ WINDOWS, МОНИТОР -->
            <local:PageShell x:Name="PageDrivers" Visibility="Collapsed">
                <!-- «Драйверы» и «Обновления Windows» — одна страница: что показать, выбирает пункт меню (переключатель скрыт) -->
                <DockPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <Border DockPanel.Dock="Right" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DrvTabDrv" Style="{StaticResource Seg}" GroupName="drvTabs" Content="Драйверы" IsChecked="True"/>
                            <RadioButton x:Name="DrvTabWin" Style="{StaticResource Seg}" GroupName="drvTabs" Content="Обновления Windows"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,16,0">
                        <StackPanel x:Name="DrvHead">
                            <TextBlock Text="Драйверы" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Text="Драйверы видеокарты и звука, программы производителей."/>
                        </StackPanel>
                        <StackPanel x:Name="WinHead" Visibility="Collapsed">
                            <TextBlock Text="Обновления Windows" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Text="Обновления Windows и драйверов, проверка активации. Ставятся в фоне, пока вы пользуетесь Merno."/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
                <!-- основная колонка: что можно поставить или поменять -->
                <Grid local:PageShell.Part="Main">
                    <ScrollViewer x:Name="DrvScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel x:Name="DrvMain" Margin="0,0,0,20"/>
                    </ScrollViewer>
                    <ScrollViewer x:Name="WinScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel x:Name="WinMain" Margin="0,0,0,20"/>
                    </ScrollViewer>
                </Grid>
                <!-- боковая панель: проверка и состояние компьютера (у каждой вкладки своё) -->
                <ScrollViewer local:PageShell.Part="Side" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,20">
                        <Border x:Name="DrvCheckCard" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Проверка" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <StackPanel x:Name="DrvNoteBox" Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock x:Name="DrvNoteIcon" Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12"
                                               Foreground="{StaticResource Sub}" VerticalAlignment="Top" Margin="0,3,9,0"/>
                                    <TextBlock x:Name="DrvNote" Style="{StaticResource SubText}" VerticalAlignment="Center" MaxWidth="260" Text="Проверяю…"/>
                                </StackPanel>
                                <Button x:Name="BtnDrvRefresh" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,1,9,0"/>
                                        <TextBlock Text="Проверить ещё раз" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border x:Name="WinCheckCard" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Проверка" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <StackPanel x:Name="WinNoteBox" Orientation="Horizontal" Margin="0,8,0,12">
                                    <TextBlock x:Name="WinNoteIcon" Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12"
                                               Foreground="{StaticResource Sub}" VerticalAlignment="Top" Margin="0,3,9,0"/>
                                    <TextBlock x:Name="WinNote" Style="{StaticResource SubText}" VerticalAlignment="Center" MaxWidth="260" Text="Проверяю…"/>
                                </StackPanel>
                                <Button x:Name="BtnWinRefresh" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,1,9,0"/>
                                        <TextBlock Text="Проверить ещё раз" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="DrvSide"/>
                        <StackPanel x:Name="WinSide" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </local:PageShell>

            <!-- НАСТРОЙКИ ПРОГРАММЫ -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <!-- одна колонка строк + боковая панель (SetSidePanel) на вкладке «Настройки» -->
                <local:PageShell x:Name="SetShell" Scrolling="False">
                <StackPanel local:PageShell.Part="Header" Margin="0,0,0,16">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SetTabMain" Style="{StaticResource Seg}" GroupName="setTabs" Content="Настройки" IsChecked="True"/>
                                <RadioButton x:Name="SetTabLook" Style="{StaticResource Seg}" GroupName="setTabs" Content="Внешний вид"/>
                                <RadioButton x:Name="SetTabContact" Style="{StaticResource Seg}" GroupName="setTabs" Content="Связаться с нами"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SetTitle" Text="Настройки" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="SetSubtitle" Style="{StaticResource SubText}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Text="Как выглядит и работает Merno."/>
                </StackPanel>
                <!-- справа на вкладке «Настройки»: версия и обновления, перенос (видимость — MainWindow.About.cs) -->
                <StackPanel x:Name="SetSidePanel" local:PageShell.Part="Side">
                    <Border x:Name="RowUpdate" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Версия" Style="{StaticResource SubText}"/>
                            <TextBlock x:Name="AboutText" FontFamily="{DynamicResource Display}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="UpdStatusText" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                            <Button x:Name="BtnUpdCheck" Content="Проверить обновления" Style="{StaticResource Outline}" HorizontalAlignment="Stretch" Margin="0,14,0,0" Padding="14,8"/>
                            <Button x:Name="BtnWhatsNew" Content="Что нового" Style="{StaticResource Ghost}" HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                            <!-- авторы и лицензия -->
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,12"/>
                            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" FontSize="12.5" Text="Сделал Lowomeister."/>
                            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,0" Text="Copyright © 2026 Merno contributors. Бесплатно. Лицензия GNU GPL 3.0 или новее, без гарантий. Название и значок Merno в неё не входят."/>
                            <Button x:Name="BtnLicense" Content="Текст лицензии" Style="{StaticResource Ghost}" HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- перенос на новую Windows (наполняется в MainWindow.Transfer.cs) -->
                    <Border x:Name="RowTransfer" Style="{StaticResource CardBorder}" Padding="16"/>
                </StackPanel>
                <StackPanel local:PageShell.Part="Main" HorizontalAlignment="Stretch">
                    <!-- «Настройки»: одна колонка строк по разделам (значок · название и пояснение · переключатель/кнопка справа),
                         справа — карточки «Версия» и «Перенос» (SetSide, только на этой вкладке) -->
                    <StackPanel x:Name="SetPanelMain" HorizontalAlignment="Stretch">
                    <TextBlock Text="Вид и поведение" FontSize="15" FontWeight="SemiBold" Margin="4,4,0,10"/>
                    <Border Style="{StaticResource Plate}">
                        <DockPanel>
                            <CheckBox x:Name="SetAdvanced" DockPanel.Dock="Left" Style="{StaticResource Check}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE9E9;"/></Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Расширенный режим"/>
                                <TextBlock Style="{StaticResource RowSub}" Text="Добавит в меню «Настройки Windows» и «Контекстное меню». Для опытных пользователей."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Plate}">
                        <DockPanel>
                            <CheckBox x:Name="SetSideOpen" DockPanel.Dock="Left" Style="{StaticResource Check}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE700;"/></Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Показывать названия в меню"/>
                                <TextBlock Style="{StaticResource RowSub}" Text="Если выключено, слева видны только значки."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border x:Name="RowAutostart" Style="{StaticResource Plate}">
                        <DockPanel>
                            <CheckBox x:Name="SetAutostart" DockPanel.Dock="Left" Style="{StaticResource Check}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7E8;"/></Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Запускать вместе с Windows"/>
                                <TextBlock Style="{StaticResource RowSub}" Text="Merno запустится значком в трее, чтобы быстрая очистка всегда была под рукой."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border x:Name="RowCloseAction" Style="{StaticResource Plate}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" VerticalAlignment="Top" Margin="30,2,14,0"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8BB;"/></Border>
                            <!-- выбор под описанием, как в «Ограничить скорость скачивания»: три кнопки справа сжимали строку в узком окне -->
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="При закрытии окна"/>
                                <TextBlock Style="{StaticResource RowSub}" Text="При выборе «В трей» Merno останется значком. Правый щелчок по нему откроет быструю очистку и команду «Выход»."/>
                                <Border Background="{StaticResource Bg}" CornerRadius="10" HorizontalAlignment="Left" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SetCloseAsk" Style="{StaticResource Seg}" GroupName="closeAct" Content="Спросить"/>
                                        <RadioButton x:Name="SetCloseTray" Style="{StaticResource Seg}" GroupName="closeAct" Content="В трей"/>
                                        <RadioButton x:Name="SetCloseExit" Style="{StaticResource Seg}" GroupName="closeAct" Content="Закрыть"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Масштаб интерфейса (MainWindow.Scale.cs): «Авто» увеличивает всё на 2K и 4K, если в Windows стоит 100 % -->
                    <Border x:Name="RowUiScale" Style="{StaticResource Plate}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="30,0,14,0"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE740;"/></Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                <CheckBox x:Name="UiScaleAuto" Style="{StaticResource Check}" Content="Авто" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Slider x:Name="UiScaleSlider" Style="{StaticResource Range}" Minimum="50" Maximum="200" TickFrequency="25" IsSnapToTickEnabled="True"
                                        SmallChange="25" LargeChange="25" Width="150" VerticalAlignment="Center"/>
                                <TextBlock x:Name="UiScaleVal" Width="52" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Размер интерфейса"/>
                                <TextBlock Style="{StaticResource RowSub}" Text="На 2K и 4K всё может быть мелким. «Авто» подберёт размер сам."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Скачивание и обновления" FontSize="15" FontWeight="SemiBold" Margin="4,18,0,10"/>
                    <!-- Ограничение скорости скачивания (MainWindow.NetLimit.cs, Core/NetLimit.cs): варианты + «Своё» -->
                    <Border x:Name="RowNetLimit" Style="{StaticResource Plate}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" VerticalAlignment="Top" Margin="30,2,14,0"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE896;"/></Border>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Ограничить скорость скачивания"/>
                                <TextBlock Style="{StaticResource RowSub}" Text="Чтобы игры, видео и звонки не тормозили, пока качаются обновления Windows, Microsoft Store и программы."/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Border Background="{StaticResource Bg}" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel x:Name="NetLimitSeg" Orientation="Horizontal"/>
                                    </Border>
                                    <TextBox x:Name="NetLimitCustom" Width="64" Height="32" Margin="10,0,0,0" Padding="8,0" VerticalContentAlignment="Center" FontSize="14"
                                             Visibility="Collapsed" MaxLength="4" ToolTip="Своя скорость: от 1 до 1000 Мбит/с. Нажмите Enter."/>
                                    <TextBlock x:Name="NetLimitUnit" Text="Мбит/с" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Plate}">
                        <DockPanel>
                            <CheckBox x:Name="SetAutoUpdate" DockPanel.Dock="Left" Style="{StaticResource Check}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE895;"/></Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Проверять обновления Merno сам"/>
                                <TextBlock Style="{StaticResource RowSub}" Text="Скажет, когда выйдет новая версия. Без вашего согласия ничего не ставится."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Если что-то пошло не так" FontSize="15" FontWeight="SemiBold" Margin="4,18,0,10"/>
                    <Border Style="{StaticResource Plate}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="30,0,14,0"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7A7;"/></Border>
                            <Button x:Name="BtnOpenRollback" DockPanel.Dock="Right" Content="Открыть" Style="{StaticResource Outline}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Откат изменений"/>
                                <TextBlock Style="{StaticResource RowSub}" Text="Вернуть настройки, которые изменил Merno."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Plate}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="30,0,14,0"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A5;"/></Border>
                            <Button x:Name="BtnOpenLog" DockPanel.Dock="Right" Content="Открыть" Style="{StaticResource Outline}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Журнал"/>
                                <TextBlock Style="{StaticResource RowSub}" Text="Всё, что делал Merno."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Plate}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="30,0,14,0"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE897;"/></Border>
                            <Button x:Name="BtnTour" DockPanel.Dock="Right" Content="Показать" Style="{StaticResource Outline}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Обучение"/>
                                <TextBlock Style="{StaticResource RowSub}" Text="Показать подсказки первого запуска ещё раз."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    </StackPanel>

                    <!-- ВНЕШНИЙ ВИД: темы оформления (MainWindow.Look.cs) -->
                    <StackPanel x:Name="SetPanelLook" Visibility="Collapsed">
                        <WrapPanel x:Name="LookList"/>
                        <TextBlock Text="Значок" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,4"/>
                        <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,10" Text="В окне, на панели задач и в трее. У ярлыка и файла Merno всегда плавный значок."/>
                        <WrapPanel x:Name="LookIcons"/>
                        <DockPanel x:Name="LookRestart" Visibility="Collapsed" Margin="0,10,0,0">
                            <Button x:Name="BtnLookRestart" DockPanel.Dock="Left" Content="Перезапустить сейчас" Style="{StaticResource Primary}"/>
                            <TextBlock Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="14,0,0,0" Text="Тема включится после перезапуска."/>
                        </DockPanel>
                    </StackPanel>
                    <!-- СВЯЗАТЬСЯ С НАМИ -->
                    <!-- форма не шире 1000 и прижата влево -->
                    <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1000"/><ColumnDefinition Width="0.001*"/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="SetPanelContact" Visibility="Collapsed">
                        <!-- Merno сам ничего не отправляет: человек пишет в Telegram-бот поддержки (Core/Feedback.cs) -->
                        <Border x:Name="FbTelegram" Style="{StaticResource Plate}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,14,0"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE715;"/></Border>
                                <Button x:Name="BtnFbTelegram" DockPanel.Dock="Right" Content="Написать" Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Написать в Telegram"/>
                                    <TextBlock Style="{StaticResource RowSub}" TextWrapping="Wrap" Text="Ошибка, идея или вопрос. Можно приложить снимок экрана. Ответим там же."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border x:Name="FbCopyInfo" Style="{StaticResource Plate}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,14,0"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8C8;"/></Border>
                                <Button x:Name="BtnFbCopy" DockPanel.Dock="Right" Content="Скопировать" Style="{StaticResource Outline}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Скопировать сведения"/>
                                    <TextBlock Style="{StaticResource RowSub}" TextWrapping="Wrap" Text="Версии Merno и Windows и последние ошибки, без имён и путей. Вставьте их в сообщение, чтобы мы быстрее нашли причину."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="FbStatus" Margin="0,8,0,0" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource Sub}"/>
                    </StackPanel>
                    </Grid>
                </StackPanel>
                </local:PageShell>
            </ScrollViewer>

            <!-- Постоянная подсказка «где исправить», пока её не закроют -->
            <Border x:Name="FeatureHint" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource AccentSoft}"
                    BorderBrush="{StaticResource Accent}" BorderThickness="0,1,0,0" Padding="48,9,48,9">
                <!-- кнопки сразу за текстом, а не на другом краю окна; подсказка сама уходит по щелчку в окне или через 10 с (ClearHint) -->
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FeatureHintText" VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource Text}"
                               TextWrapping="Wrap" MaxWidth="760" Margin="0,4,16,4"/>
                    <Button x:Name="FeatureHintGo" Content="Открыть «Главную»" Margin="0,0,10,0" Padding="14,4,14,4" VerticalAlignment="Center"
                            Visibility="Collapsed"/>
                    <!-- «Понятно» убрана: подсказка уходит сама (через 15 с или по щелчку), Esc тоже закрывает -->
                    <Button x:Name="FeatureHintClose" Visibility="Collapsed"/>
                </WrapPanel>
            </Border>

            <!-- Строка состояния (над ней — полоска «Доступно обновление», MainWindow.Update.cs) -->
            <StackPanel Grid.Row="2">
            <Border x:Name="UpdBanner" Visibility="Collapsed" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                    BorderThickness="0,1,0,0" Padding="48,7,48,7">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UpdBtnInstall" Content="Обновить" Style="{StaticResource Primary}" Margin="12,0,0,0" Padding="14,4,14,4"/>
                        <Button x:Name="UpdBtnNotes" Content="Что нового" Margin="8,0,0,0" Padding="12,4,12,4"/>
                        <Button x:Name="UpdBtnLater" Content="Позже" Margin="8,0,0,0" Padding="12,4,12,4"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdBannerText" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Text}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <Border x:Name="StatusBar" Background="{StaticResource Side}" Padding="48,9,48,9">
                <DockPanel>
                    <!-- ход установки (вариант Б): деления по программе, «3 из 5», список по щелчку (кроме раздела «Программы») — MainWindow.InstallProgress.cs -->
                    <StackPanel x:Name="InstBar" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="16,0,0,0" Cursor="Hand" Background="Transparent">
                        <StackPanel x:Name="InstSeg" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <TextBlock x:Name="InstCount" Foreground="{StaticResource Sub}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="InstToggle" Foreground="{StaticResource Accent}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" Text="список"/>
                    </StackPanel>
                    <Popup x:Name="InstPop" PlacementTarget="{Binding ElementName=InstBar}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-10">
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,12" Width="320">
                            <StackPanel x:Name="InstPopList"/>
                        </Border>
                    </Popup>
                    <TextBlock x:Name="BusyIcon" DockPanel.Dock="Left" Text="&#xE895;" FontFamily="{StaticResource Icons}" FontSize="13"
                               Foreground="{StaticResource Accent}" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                    </TextBlock>
                    <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="7" Height="7" Fill="{StaticResource Ok}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="Status" Text="" Foreground="{StaticResource Sub}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            </StackPanel>
        </Grid>
            <!-- ОБУЧЕНИЕ ПРИ ПЕРВОМ ЗАПУСКЕ -->
        <Grid x:Name="Tour" Grid.ColumnSpan="2" Panel.ZIndex="10" Visibility="Collapsed" Background="Transparent">
            <Path x:Name="TourShade" Fill="{StaticResource TourShadeBg}"/>
            <Canvas>
                <Border x:Name="TourRing" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="10" IsHitTestVisible="False"/>
                <!-- «хвостик» карточки, указывает на подсвеченный пункт меню -->
                <Path x:Name="TourArrow" Data="M 10,0 L 0,9 L 10,18 Z" Fill="{StaticResource Panel}" Stroke="{StaticResource Line}" StrokeThickness="1"
                      Panel.ZIndex="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                <Border x:Name="TourCard" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                        Width="400" Padding="24,20">
                    <StackPanel>
                        <TextBlock x:Name="TourStep" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="TourTitle" Style="{StaticResource H2}" FontSize="19" Margin="0,6,0,8" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TourText" Style="{StaticResource SubText}" FontSize="14"/>
                        <DockPanel Margin="0,20,0,0">
                            <!-- «Далее» заполняется полоской, пока идёт показ шага; нажать можно, когда заполнится -->
<!-- «Далее»: тёмная дорожка заполняется бирюзой слева направо; текст всегда поверх заливки и читается -->
                            <Grid DockPanel.Dock="Right" Height="36" MinWidth="112" ClipToBounds="True">
                                <Border x:Name="TourTrack" Background="{StaticResource TourTrackBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7"/>
                                <Border x:Name="TourFill" HorizontalAlignment="Left" Width="0" Background="{StaticResource Accent}" CornerRadius="7"/>
                                <Button x:Name="TourNext" Content="Далее" Cursor="Hand" FocusVisualStyle="{x:Null}" Padding="22,0"
                                        FontWeight="SemiBold" Foreground="{StaticResource Text}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <Button x:Name="TourSkip" DockPanel.Dock="Left" Content="Пропустить обучение" HorizontalAlignment="Left"
                                    ToolTip="Показать обучение снова можно в разделе «Настройки» → «Обучение»."/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>

    </Grid>
</Window>
